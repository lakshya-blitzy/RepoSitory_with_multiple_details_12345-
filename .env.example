# ==============================================================================
# Testinium QA Python/Behave Test Automation Framework
# Environment Variables Template
# ==============================================================================
# 
# IMPORTANT: This is a template file with placeholder values.
# 
# Setup Instructions:
# 1. Copy this file to .env in the project root
# 2. Replace all placeholder values with your actual configuration
# 3. NEVER commit the .env file to version control
# 4. Keep sensitive credentials secure
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Browser Configuration
# ------------------------------------------------------------------------------
# Browser type to use for test execution
# Options: chrome, firefox, edge, safari
BROWSER_TYPE=chrome

# Run browser in headless mode (without GUI)
# Options: true, false
HEADLESS=false

# Browser window size (width x height)
# Format: WIDTHxHEIGHT
WINDOW_SIZE=1920x1080

# ------------------------------------------------------------------------------
# Application URLs
# ------------------------------------------------------------------------------
# Base URL of the application under test
# Replace with your actual Testinium application URL
BASE_URL=https://testinium.example.com

# Login page URL (relative to BASE_URL if applicable)
LOGIN_URL=https://testinium.example.com/login

# ------------------------------------------------------------------------------
# Timeout Configuration (in seconds)
# ------------------------------------------------------------------------------
# Default explicit wait timeout for element presence
DEFAULT_TIMEOUT=10

# Maximum time to wait for page load
PAGE_LOAD_TIMEOUT=30

# Implicit wait timeout (recommended: 0 for explicit waits only)
IMPLICIT_WAIT=0

# Short timeout for quick operations
TIMEOUT_SHORT=5

# Medium timeout for standard operations
TIMEOUT_MEDIUM=10

# Long timeout for complex operations
TIMEOUT_LONG=30

# ------------------------------------------------------------------------------
# Test Account Credentials
# ------------------------------------------------------------------------------
# SECURITY WARNING: Replace these with actual test account credentials
# Obtain real credentials from your test environment administrator
# DO NOT use production credentials for testing

# Standard test user credentials
TEST_USERNAME=user@example.com
TEST_PASSWORD=your_password_here

# Administrator account credentials
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=admin_password_here

# Sales Manager account credentials (used in Sales feature tests)
SALES_MANAGER_USERNAME=salesmanager@example.com
SALES_MANAGER_PASSWORD=salesmanager

# POS Manager account credentials (used in POS feature tests)
POS_MANAGER_USERNAME=posmanager@example.com
POS_MANAGER_PASSWORD=posmanager

# Employee test account (used in Employee feature tests)
EMPLOYEE_USERNAME=employee@example.com
EMPLOYEE_PASSWORD=employee

# ------------------------------------------------------------------------------
# Test Data Configuration
# ------------------------------------------------------------------------------
# Seed for Faker library to generate consistent test data
FAKER_SEED=12345

# Locale for Faker data generation (e.g., en_US, en_GB)
FAKER_LOCALE=en_US

# ------------------------------------------------------------------------------
# Reporting Configuration
# ------------------------------------------------------------------------------
# Directory for Allure test results
ALLURE_RESULTS_DIR=reports/allure-results

# Directory for Behave HTML reports
BEHAVE_REPORTS_DIR=reports/behave-reports

# Directory for screenshots on test failures
SCREENSHOTS_DIR=reports/screenshots

# Enable screenshot capture on test failures
CAPTURE_SCREENSHOTS_ON_FAILURE=true

# Enable video recording of test execution (if supported)
ENABLE_VIDEO_RECORDING=false

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/test_execution.log

# Enable console logging
CONSOLE_LOGGING=true

# Log format
# Options: detailed, simple
LOG_FORMAT=detailed

# ------------------------------------------------------------------------------
# Parallel Execution Configuration
# ------------------------------------------------------------------------------
# Number of parallel workers for test execution
# Set to 1 for sequential execution
# Recommended: number of CPU cores or less
PARALLEL_WORKERS=4

# Parallel execution strategy
# Options: scenario, feature
PARALLEL_STRATEGY=scenario

# ------------------------------------------------------------------------------
# CI/CD Integration
# ------------------------------------------------------------------------------
# Enable CI/CD mode (affects reporting and output formats)
CI_MODE=false

# Jenkins integration
JENKINS_URL=https://jenkins.example.com
JENKINS_JOB_NAME=testinium-qa-tests

# Jira integration for test management
JIRA_URL=https://jira.example.com
JIRA_PROJECT_KEY=UPGN
JIRA_ENABLED=false

# ------------------------------------------------------------------------------
# WebDriver Manager Configuration
# ------------------------------------------------------------------------------
# Cache directory for WebDriver binaries
WEBDRIVER_CACHE_DIR=~/.wdm

# Auto-update WebDriver binaries
WEBDRIVER_AUTO_UPDATE=true

# ------------------------------------------------------------------------------
# Optional: Database Configuration (if needed for test data setup)
# ------------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=testinium_test
# DB_USERNAME=test_user
# DB_PASSWORD=test_password

# ------------------------------------------------------------------------------
# Optional: API Configuration (if API testing is included)
# ------------------------------------------------------------------------------
# API_BASE_URL=https://api.testinium.example.com
# API_KEY=your_api_key_here
# API_TIMEOUT=30

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
# Enable specific test features or experimental functionality
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_PERFORMANCE_METRICS=false
ENABLE_ACCESSIBILITY_CHECKS=false

# ==============================================================================
# End of Configuration
# ==============================================================================
