# Environment Variables Template for Testinium Test Framework
# Copy this file to .env and fill in actual values
# The .env file should NEVER be committed to version control

# Browser Configuration (optional - overrides config.yaml)
BROWSER_TYPE=chrome
HEADLESS=false

# Test Environment
BASE_URL=https://testinium.example.com

# Timeouts (optional - overrides config.yaml)
TIMEOUT_EXPLICIT=10
TIMEOUT_PAGE_LOAD=30

# Test Credentials (REQUIRED - for security, load from environment)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=your_secure_password_here

POS_MANAGER_USERNAME=posmanager@example.com
POS_MANAGER_PASSWORD=your_secure_password_here

SALES_MANAGER_USERNAME=salesmanager@example.com
SALES_MANAGER_PASSWORD=your_secure_password_here

TEST_USERNAME=testuser@example.com
TEST_PASSWORD=your_secure_password_here

# Reporting
SCREENSHOTS_ON_FAILURE=true
